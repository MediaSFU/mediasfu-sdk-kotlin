# Project settings
org.gradle.jvmargs=-Xmx4096m -XX:MaxMetaspaceSize=1024m -XX:+HeapDumpOnOutOfMemoryError
kotlin.code.style=official
android.useAndroidX=true
android.nonTransitiveRClass=true

# =================================================================
# MediaSFU SDK Kotlin - Publishing Configuration
# =================================================================
# Release versions are tracked in version.properties.
pomGroup=com.mediasfu
pomArtifactId=mediasfu-sdk
pomName=MediaSFU Kotlin Multiplatform SDK
pomDescription=Production-ready Kotlin Multiplatform SDK for real-time communication with MediaSFU
pomUrl=https://github.com/MediaSFU/mediasfu-sdk-kotlin
pomScmUrl=https://github.com/MediaSFU/mediasfu-sdk-kotlin
pomScmConnection=scm:git@github.com:MediaSFU/mediasfu-sdk-kotlin.git
pomScmDeveloperConnection=scm:git@github.com:MediaSFU/mediasfu-sdk-kotlin.git
pomLicenseName=MIT License
pomLicenseUrl=https://opensource.org/licenses/mit-license.php
pomDeveloperName=MediaSFU Team
pomDeveloperEmail=info@mediasfu.com

# =================================================================
# Maven Central Portal credentials (get from https://central.sonatype.com/)
# =================================================================
mavenCentralUsername=YOUR_USERNAME
mavenCentralPassword=YOUR_PASSWORD

# =================================================================
# GPG Signing (for publishing to Maven Central)
# =================================================================
signing.keyId=YOUR_KEY_ID
signing.password=YOUR_GPG_PASSWORD
signing.secretKeyRingFile=/path/to/.gnupg/secring.gpg
